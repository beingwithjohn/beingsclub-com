{
  "name": "practice-log",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Worker for Beings Club; the Practice Log frontend now lives on spacetobe.xyz.",
  "scripts": {
    "build": "node app/build.js",
    "test": "node --test 'test/*.test.js'",
    "check": "node test/retired-frontend-checks.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply practice-log --local",
    "db:remote": "wrangler d1 migrations apply practice-log --remote",
    "db:members:local": "wrangler d1 migrations apply beings-club-members --local",
    "db:members:remote": "wrangler d1 migrations apply beings-club-members --remote"
  },
  "devDependencies": {
    "wrangler": "^4.127.1"
  }
}
